# Optional contact delivery. Copy this file to `.env` for local Vite,
# or set the same names in Netlify → Site configuration → Environment variables.
# Vite reads them at build time, so change them and rebuild.
#
# These values are embedded in the public site bundle. Do not put API keys,
# passwords, or other secrets here. A Formspree form id is public by design.

# If set, the contact form opens the visitor's email app addressed here.
# Example: VITE_CONTACT_EMAIL=hello@umersyedahmed.com
VITE_CONTACT_EMAIL=

# If set, the contact form POSTs to https://formspree.io/f/<this id>
# and this takes priority over VITE_CONTACT_EMAIL.
# Example: VITE_FORMSPREE_FORM_ID=abcdwxyz
VITE_FORMSPREE_FORM_ID=
