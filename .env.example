# The contact form does not use environment variables.
# It posts to Netlify Forms. Set the email recipient in
# Netlify → Project configuration → Forms → Form notifications.

# Hosted checkout. Leave unset for the demo button.
# See docs/payments.md. Only buy.stripe.com, checkout.stripe.com,
# square.link, and checkout.square.site links are accepted.
# VITE_CHECKOUT_MODE=demo
# VITE_CHECKOUT_URL_SIMPLER_DEPOSIT=
# VITE_CHECKOUT_URL_ADVANCED_DEPOSIT=
